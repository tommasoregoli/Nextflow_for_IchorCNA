docker.enabled = true
wave.enabled = true

params {
    // Cartella risultati di default
    outdir = './results'
    
    // Indica alla pipeline come pubblicare i file (es. copiandoli)
    publish_dir_mode = 'copy' 

    // Input generici di default
    slop = 0
    CRAM = './samples.csv'
    bed = 'PATH/of/your/BED/file'
    reference = 'PATH/of/your/reference/fasta/file'
    reference_index = 'PATH/of/your/reference/fasta/file/index'
    BED_Slop_and_Merge = false
}


// Inserire un file nel pc risorse_pc.config compilato come i punti 1 e 2 inserendo i propri limiti di risorse. 
// Indicarlo nel comando nextflow run con l'opzione -c risorse_pc.config
// 1. IL LIMITE GLOBALE DEL TUO PC (Massimo consumo cumulativo)
//executor {
//    name = 'local'
//    cpus = n        // Nextflow non userà MAI più di n CPU in TOTALE contemporaneamente
//    memory = n.GB   // Nextflow non userà MAI più di n GB di RAM in TOTALE contemporaneamente
//}



// 2. LA CONFIGURAZIONE DEI PROCESSI
//process {
    // Risorse di partenza standard che dai a ogni singolo processo
//    cpus = 2
//    memory = 4.GB

    // Il freno di emergenza per il singolo processo (Nuova sintassi)
//    resourceLimits = [
//        cpus: 12,
//        memory: 24.GB,
//        time: 96.h
//    ]
//}

workflow {
    output {
        mode = 'copy'
    }
}
